<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="leacer_network.net.xml"/>
    <route-files value="leacer_routes.rou.xml"/>
    <additional-files value="leacer_detectors.add.xml,leacer_polygons.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="1.0"/>
  </time>
  <processing>
    <ignore-route-errors value="true"/>
    <time-to-teleport value="-1"/>
    <waiting-time-memory value="100"/>
    <max-depart-delay value="60"/>
  </processing>
  <output>
    <summary-output value="../results/summary.xml"/>
    <tripinfo-output value="../results/tripinfo.xml"/>
    <queue-output value="../results/queues.xml"/>
    <emission-output value="../results/emissions.xml"/>
  </output>
  <random>
    <seed value="42"/>
  </random>
  <report>
    <no-step-log value="true"/>
    <duration-log.statistics value="true"/>
    <delay value="40"/>
  </report>
  <gui_only>
    <gui-settings-file value="leacer_gui_settings.xml"/>
    <window-size value="1600,900"/>
    <window-pos value="60,40"/>
  </gui_only>
</configuration>